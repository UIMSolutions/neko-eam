<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog id="passwordDialog" title="{pw>/title}" contentWidth="24rem" busy="{pw>/busy}" busyIndicatorDelay="0"
		class="sapUiContentPadding">
		<content>
			<VBox>
				<MessageStrip text="{pw>/hint}" type="{pw>/hintType}" showIcon="true" visible="{= !!${pw>/hint} }"
					class="sapUiSmallMarginBottom" />
				<Label text="{i18n>passwordCurrent}" labelFor="passwordCurrent" required="true" visible="{= ${pw>/mode} === 'own' }" />
				<Input id="passwordCurrent" type="Password" value="{pw>/current}" visible="{= ${pw>/mode} === 'own' }"
					valueState="{pw>/currentState}" valueStateText="{pw>/currentStateText}" liveChange=".onPasswordInput" width="100%" />
				<Label text="{i18n>passwordNew}" labelFor="passwordNew" required="true" class="sapUiSmallMarginTop" />
				<Input id="passwordNew" type="Password" value="{pw>/password}" valueState="{pw>/passwordState}"
					valueStateText="{pw>/passwordStateText}" liveChange=".onPasswordInput" width="100%" />
				<Label text="{i18n>passwordRepeat}" labelFor="passwordRepeat" required="true" class="sapUiSmallMarginTop" />
				<Input id="passwordRepeat" type="Password" value="{pw>/repeat}" valueState="{pw>/repeatState}"
					valueStateText="{i18n>passwordMismatch}" liveChange=".onPasswordInput" submit=".onPasswordSave" width="100%" />
				<Text text="{i18n>passwordRules}" class="sapUiTinyMarginTop" />
				<CheckBox text="{i18n>passwordMustChange}" selected="{pw>/mustChange}" visible="{= ${pw>/mode} === 'admin' }"
					class="sapUiSmallMarginTop" />
			</VBox>
		</content>
		<buttons>
			<Button id="passwordSaveButton" text="{i18n>save}" type="Emphasized" press=".onPasswordSave" />
			<Button id="passwordRemoveButton" text="{i18n>passwordRemove}" type="Reject" press=".onPasswordRemove"
				visible="{= ${pw>/mode} === 'admin' &amp;&amp; ${pw>/hasPassword} }" />
			<Button text="{= ${pw>/forced} ? ${i18n>passwordLater} : ${i18n>cancel} }" press=".onPasswordCancel" />
		</buttons>
	</Dialog>
</core:FragmentDefinition>
