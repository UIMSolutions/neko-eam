<?xml version="1.0" encoding="utf-8"?>
<!-- Neko EAM servers often run on an intranet or a developer machine without TLS
     (the emulator reaches the host as 10.0.2.2). Cleartext is allowed so such servers
     can be used; production servers should be reached via https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
